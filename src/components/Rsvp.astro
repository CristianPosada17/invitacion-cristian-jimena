---
import Ornament from "./Ornament.astro";
---
<div class="wrap">
  <Ornament />
  <div id="rsvp-box">
    <div class="card center">
      <h3 style="font-family:var(--font-serif);font-size:22px;margin:0 0 6px">Buscando tu invitación</h3>
      <p class="hint">Estamos cargando tus datos personalizados…</p>
    </div>
  </div>
  <div style="height:20px"></div>
</div>

<script>
  import { loadGuest, esc, toast } from "../lib/state";
  import { getToken } from "../lib/config";
  import { submitRsvp } from "../lib/api";

  const box = document.getElementById("rsvp-box");
  let pickAsiste = true;
  let state: any = null;

  function setA(v: boolean) {
    pickAsiste = v;
    document.getElementById("a-si")?.classList.toggle("on", v);
    document.getElementById("a-no")?.classList.toggle("on", !v);
  }

  function celebrateAttendance() {
    if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) return;
    const stage = document.getElementById("frame");
    if (!stage) return;

    const previous = stage.querySelector(".celebration-canvas");
    previous?.remove();

    const canvas = document.createElement("canvas");
    canvas.className = "celebration-canvas";
    canvas.setAttribute("aria-hidden", "true");
    stage.appendChild(canvas);

    const width = stage.clientWidth;
    const height = stage.clientHeight;
    const dpr = Math.min(window.devicePixelRatio || 1, 2);
    canvas.width = Math.round(width * dpr);
    canvas.height = Math.round(height * dpr);
    const context = canvas.getContext("2d");
    if (!context) { canvas.remove(); return; }
    context.scale(dpr, dpr);

    const colors = ["#b8965a", "#d9bd7a", "#f0dfb6", "#9ba589", "#fffaf0"];
    const particles = Array.from({ length: 150 }, (_, index) => {
      const direction = index % 2 === 0 ? 1 : -1;
      return {
        x: direction === 1 ? width * 0.1 : width * 0.9,
        y: height * (0.78 + Math.random() * 0.12),
        vx: direction * (1.5 + Math.random() * 4.5) + (Math.random() - 0.5),
        vy: -(3.8 + Math.random() * 7.2),
        gravity: 0.07 + Math.random() * 0.055,
        drag: 0.986 + Math.random() * 0.008,
        rotation: Math.random() * Math.PI * 2,
        spin: (Math.random() - 0.5) * 0.24,
        size: 2.2 + Math.random() * 4.8,
        life: 92 + Math.random() * 62,
        color: colors[Math.floor(Math.random() * colors.length)],
        sparkle: Math.random() < 0.34,
      };
    });

    function drawSparkle(size: number) {
      context!.beginPath();
      context!.moveTo(0, -size);
      context!.lineTo(size * 0.28, -size * 0.28);
      context!.lineTo(size, 0);
      context!.lineTo(size * 0.28, size * 0.28);
      context!.lineTo(0, size);
      context!.lineTo(-size * 0.28, size * 0.28);
      context!.lineTo(-size, 0);
      context!.lineTo(-size * 0.28, -size * 0.28);
      context!.closePath();
      context!.fill();
    }

    function animate() {
      context!.clearRect(0, 0, width, height);
      let active = false;
      particles.forEach((particle) => {
        if (particle.life <= 0 || particle.y > height + 30) return;
        active = true;
        particle.life -= 1;
        particle.vx *= particle.drag;
        particle.vy += particle.gravity;
        particle.x += particle.vx;
        particle.y += particle.vy;
        particle.rotation += particle.spin;

        context!.save();
        context!.translate(particle.x, particle.y);
        context!.rotate(particle.rotation);
        context!.globalAlpha = Math.min(1, particle.life / 24);
        context!.fillStyle = particle.color;
        if (particle.sparkle) drawSparkle(particle.size);
        else context!.fillRect(-particle.size * 0.55, -particle.size * 0.22, particle.size * 1.1, particle.size * 0.44);
        context!.restore();
      });

      if (active) window.requestAnimationFrame(animate);
      else canvas.remove();
    }

    window.requestAnimationFrame(animate);
    window.setTimeout(() => canvas.remove(), 3600);
  }

  async function submit() {
    const guest = state.guest;
    const token = getToken();
    const attending = pickAsiste;
    const sel = document.getElementById("f-pases") as HTMLSelectElement | null;
    const pases = attending ? Number(sel?.value) || 0 : 0;
    if (attending && !pases) { toast("Selecciona el número de pases"); return; }
    const tel = (document.getElementById("f-tel") as HTMLInputElement | null)?.value || "";
    toast("Enviando...");
    try {
      const r = await submitRsvp(token, attending, pases, tel.trim());
      if (r && r.ok) {
        guest.confirmado = true;
        guest.asiste = attending;
        guest.pases_confirmados = r.pases;
        render();
        document.body.dispatchEvent(new CustomEvent("rsvp:done"));
        if (attending) window.setTimeout(celebrateAttendance, 120);
        toast(attending ? "¡Confirmado! Gracias" : "Registrado, gracias");
      } else toast("No se pudo guardar, intenta de nuevo");
    } catch (e) {
      toast("Sin conexión, intenta de nuevo");
    }
  }

  function render() {
    if (!box) return;
    const token = getToken();
    const guest = state?.guest;
    if (!token) {
      box.innerHTML =
        '<div class="card center"><h3 style="font-family:var(--font-serif);font-size:22px;margin:0 0 6px">Confirma tu Asistencia</h3><p class="hint">Abre tu invitación desde el <b>link personalizado</b> que te enviamos por WhatsApp para poder confirmar.</p></div>';
      return;
    }
    if (state?.guestStatus === "error") {
      box.innerHTML =
        '<div class="card center"><h3 style="font-family:var(--font-serif);font-size:22px;margin:0 0 6px">No pudimos cargar tu invitación</h3><p class="hint">Revisa tu conexión e inténtalo nuevamente.</p><button class="btn ghost mt" id="retryGuest">Volver a intentar</button></div>';
      document.getElementById("retryGuest")?.addEventListener("click", () => window.location.reload());
      return;
    }
    if (!guest) {
      box.innerHTML =
        '<div class="card center"><h3 style="font-family:var(--font-serif);font-size:22px;margin:0 0 6px">No encontramos tu invitación</h3><p class="hint">Verifica que abriste el link completo que te enviamos, o escríbenos por WhatsApp.</p></div>';
      return;
    }
    if (guest.confirmado) {
      if (guest.asiste) {
        const p = guest.pases_confirmados || guest.max_pases;
        box.innerHTML =
          '<div class="confirmed-state"><div class="sec-title">Estás Confirmado</div><div class="sec-sub mb">Nos vemos el 3 de abril</div>' +
          '<p class="center hint mb" style="margin-top:10px">' + esc(guest.nombre) + " · " + p + " " + (p > 1 ? "pases" : "pase") +
          '.<br>Ve a la sección <b>Detalles</b> para ver tu pase y tu mesa.</p>' +
          '<button class="btn ghost mt" type="button" id="goDetails">Ver mi pase y detalles</button></div>';
        document.getElementById("goDetails")?.addEventListener("click", () => {
          const details = document.getElementById("detalles");
          if (!details) return;
          details.scrollIntoView({ behavior: "smooth", block: "start" });
          history.replaceState(null, "", location.pathname + location.search + "#detalles");
        });
      } else {
        box.innerHTML =
          '<div class="card center"><h3 style="font-family:var(--font-serif);font-size:23px;margin:0 0 6px">Gracias, ' +
          esc((guest.nombre || "").split(" ")[0]) +
          '</h3><p class="hint">Registramos que no podrás acompañarnos. Te vamos a extrañar.</p></div>';
      }
      return;
    }
    let opts = '<option value="">Selecciona</option>';
    for (let i = 1; i <= (guest.max_pases || 1); i++) opts += "<option>" + i + "</option>";
    box.innerHTML =
      '<div class="sec-title">Confirma tu Asistencia</div>' +
      '<div class="sec-sub mb">Tienes ' + (guest.max_pases || 0) + " " + ((guest.max_pases || 0) > 1 ? "pases" : "pase") + " reservados</div>" +
      '<div class="card mt"><label class="f">Invitación para</label><input class="t" value="' + esc(guest.nombre) + '" disabled>' +
      '<div class="mt"><label class="f">Teléfono o correo</label><input class="t" id="f-tel" placeholder="Tu teléfono o correo"></div>' +
      '<div class="mt"><label class="f">Número de pases (máx. ' + (guest.max_pases || 1) + ')</label><select class="t" id="f-pases">' + opts + "</select></div>" +
      '<div class="mt"><label class="f">¿Asistirás?</label><div class="toggle"><button id="a-si" class="on">Sí, asistiré</button><button id="a-no">No podré</button></div></div></div>' +
      '<button class="btn" id="btnRsvp">Enviar confirmación</button>' +
      '<p class="hint center mt">Tu confirmación es muy importante para nosotros.</p>';
    pickAsiste = true;
    document.getElementById("a-si")?.addEventListener("click", () => setA(true));
    document.getElementById("a-no")?.addEventListener("click", () => setA(false));
    document.getElementById("btnRsvp")?.addEventListener("click", submit);
  }

  loadGuest()
    .then((s) => { state = s; render(); })
    .catch(() => { state = { guestStatus: "error" }; render(); });
</script>
<style is:global>
  #rsvp-box .confirmed-state .sec-title {
    color: #443b31;
    font-size: 29px;
    font-weight: 500;
  }
  #rsvp-box .confirmed-state .sec-sub {
    color: #776c5c;
    font-size: 14px;
    font-weight: 400;
  }
  #rsvp-box .confirmed-state .hint {
    color: #766a5a;
    font-size: 13.5px;
    font-weight: 400;
    line-height: 1.65;
  }
  #rsvp-box .confirmed-state .hint b {
    color: #554b3e;
    font-weight: 500;
  }
  #rsvp-box .confirmed-state .btn.ghost {
    border-color: #ad8848;
    background: rgba(255, 253, 248, 0.92);
    color: #87662f;
    font-weight: 500;
    box-shadow: 0 10px 24px -20px rgba(74, 65, 54, 0.75);
  }
  #frame .celebration-canvas {
    position: absolute;
    inset: 0;
    z-index: 175;
    width: 100%;
    height: 100%;
    pointer-events: none;
  }
</style>
<!-- El contador regresivo vive únicamente en Countdown.astro para evitar duplicados. -->
