---
import SectionTitle from "./SectionTitle.astro";
import { icon } from "../lib/icons";
---

<div class="wrap">
  <SectionTitle title="Contacto" />
  <div class="card">
    <div class="dcard">
      <div class="ic" set:html={icon("phone")}></div>
      <div class="tx">
        <b>¿Tienes alguna duda?</b>
        <span>Escríbenos por WhatsApp</span>
      </div>
    </div>
  </div>
  <div class="card" data-install-card>
    <div class="dcard" style="padding-bottom:14px">
      <div class="ic" set:html={icon("plus")}></div>
      <div class="tx">
        <b>Guárdala en tu teléfono</b>
        <span>Ábrela como app desde tu pantalla de inicio</span>
      </div>
    </div>
    <button type="button" class="btn ghost" data-install-open>Ver cómo guardarla</button>
  </div>
  <div style="height:20px"></div>
</div>
