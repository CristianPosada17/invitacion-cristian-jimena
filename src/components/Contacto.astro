---
import SectionTitle from "./SectionTitle.astro";
import { icon } from "../lib/icons";
import { CONTACTOS } from "../lib/config";
---

<div class="wrap">
  <SectionTitle icon="phone" title="Contacto" />
  <div class="card" data-letter="drop">
    <div class="dcard">
      <div class="ic" set:html={icon("phone")}></div>
      <div class="tx">
        <b>¿Tienes alguna duda?</b>
        <span>Escríbenos por WhatsApp</span>
      </div>
    </div>
    <div class="wa">
      {CONTACTOS.map((c) => (
        <a class="btn ghost" href={`https://wa.me/${c.whatsapp}`} target="_blank" rel="noopener">
          <Fragment set:html={icon("phone")} />
          {c.nombre}
        </a>
      ))}
    </div>
  </div>
  <div class="card" data-install-card data-letter="open">
    <div class="dcard" style="padding-bottom:14px">
      <div class="ic" set:html={icon("plus")}></div>
      <div class="tx">
        <b>Guárdala en tu teléfono</b>
        <span>Ábrela como app desde tu pantalla de inicio</span>
      </div>
    </div>
    <button type="button" class="btn ghost" data-install-open>Ver cómo guardarla</button>
  </div>
  <div style="height:20px"></div>
</div>

<style>
  .wa {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 10px;
    margin-top: 16px;
  }
  .wa .btn {
    text-decoration: none;
  }
</style>
