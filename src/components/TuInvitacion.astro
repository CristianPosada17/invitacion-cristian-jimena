---
import SectionTitle from "./SectionTitle.astro";
---
<div class="wrap">
  <SectionTitle title="Tu Invitación" sub="Tu pase y tu mesa" />
  <div class="divider">✦</div>
  <div id="pass-body"></div>
</div>

<script>
  import { boot, loadGuest, daysLeft, esc, countdownParts } from "../lib/state";
  import { getToken } from "../lib/config";
  import { icon } from "../lib/icons";

  const el = document.getElementById("pass-body");
  let state: any = null;
  const cdHTML = () =>
    countdownParts().map((p) => `<div class="cd"><b>${p[1]}</b><span>${p[0]}</span></div>`).join("");

  function render() {
    if (!el) return;
    const token = getToken();
    const guest = state?.guest;
    const revealDays = state?.revealDays ?? 15;
    if (!token || !guest) {
      el.innerHTML =
        '<div class="locked"><div class="ico">' + icon("ticket") +
        '</div><b>Abre tu link personalizado</b><br><span class="hint">Desde el link que te enviamos verás aquí tu pase y tu mesa</span></div>';
      return;
    }
    if (!guest.confirmado) {
      el.innerHTML =
        '<div class="locked"><div class="ico">' + icon("ticket") +
        '</div><b>Aún no confirmas</b><br><span class="hint">Confirma tu asistencia arriba para activar tu pase</span></div>';
      return;
    }
    if (!guest.asiste) {
      el.innerHTML = '<div class="card center"><p class="hint">No registraste asistencia. Si algo cambia, escríbenos.</p></div>';
      return;
    }
    const d = daysLeft();
    const rev = d <= revealDays;
    const pases = guest.pases_confirmados || guest.max_pases;
    let h =
      '<div class="card center mb"><div class="eyebrow">Confirmado</div><h3 style="font-family:var(--font-serif);font-size:25px;margin:6px 0 2px">' +
      esc(guest.nombre) + '</h3><span class="pill">' + pases + " " + (pases > 1 ? "pases" : "pase") + "</span></div>" +
      '<div class="countdown">' + cdHTML() + "</div>" +
      '<p class="center hint mb">' + (rev ? "Ya casi es el gran día." : "Tus pases y tu mesa se activan entre 15 y 5 días antes del evento.") + "</p>";
    if (!rev) {
      h +=
        '<div class="locked"><div class="ico">' + icon("ticket") + '</div><b>Tus pases</b><br><span class="hint">Se activan entre 15 y 5 días antes</span></div>' +
        '<div class="locked"><div class="ico">' + icon("plate") + '</div><b>Tu mesa</b><br><span class="hint">Se activa entre 15 y 5 días antes</span></div>';
    } else {
      h +=
        '<div class="pass"><div class="eyebrow">Pase de entrada</div><div class="n">' + esc(guest.nombre) + "</div>" +
        '<div style="display:flex;justify-content:space-between;align-items:flex-end;margin-top:10px"><div><span class="hint">Admite</span><br><b style="font-family:var(--font-serif);font-size:25px;color:var(--color-gold-d)">' + pases + ' personas</b></div><div style="text-align:right"><span class="hint">Boda C&amp;J</span><br><b style="font-family:var(--font-serif);font-size:19px">03·04·27</b></div></div></div>' +
        '<div class="card center"><div class="eyebrow">Tu mesa</div><div class="tablebig">' + (guest.mesa || "—") + '</div><p class="hint">' + (guest.mesa ? "Mesa " + esc(guest.mesa) + " · un anfitrión te llevará a tu lugar" : "Un anfitrión te llevará a tu lugar") + "</p></div>";
    }
    el.innerHTML = h;
  }

  loadGuest().then((s) => { state = s; render(); });
  boot().then((s) => { state = s; render(); });
  document.body.addEventListener("rsvp:done", render);
  setInterval(() => { const c = el?.querySelector(".countdown"); if (c) c.innerHTML = cdHTML(); }, 1000);
</script>
