---
import SectionTitle from "./SectionTitle.astro";
import { icon } from "../lib/icons";
---

<div class="wrap reveal">
  <SectionTitle title="Información Importante" />
  <div class="card">
    <div class="dcard">
      <div class="ic" set:html={icon("dress")}></div>
      <div class="tx">
        <b>Código de Vestimenta</b>
        <span>Formal / Etiqueta · Evitar el blanco</span>
      </div>
    </div>
  </div>
  <div class="notice">
    <div class="ic" set:html={icon("cheers")}></div>
    <div class="k">Solo adultos</div>
    <p class="hint mt">
      Con todo el cariño, hemos decidido que nuestra celebración sea únicamente para adultos.
      Agradecemos su comprensión.
    </p>
  </div>
</div>
