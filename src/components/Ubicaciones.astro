    paint-order: stroke;
    stroke: #fbf6ec;
    stroke-width: 7px;
  }
  .croquis-map :global(.compass circle) { fill: #fffaf0; stroke: #c2a463; stroke-width: 1.2; }
  .croquis-map :global(.needle-n) { fill: #987740; }
  .croquis-map :global(.needle-s) { fill: #d8c9a7; }
  .croquis-map :global(.compass text) { fill: #987740; font-size: 18px; font-weight: 500; }
