<script>
  import { boot } from "../lib/state";

  // Si los novios suben un croquis oficial (croquis_url en el Apps Script), reemplaza al ilustrado.
  boot().then((s) => {
    const url = s.config?.croquis_url;
    if (!url) return;
    const img = document.getElementById("croquisImg") as HTMLImageElement | null;
    const map = document.getElementById("croquisMap");
    if (img) { img.src = url; img.style.display = "block"; }
    if (map) map.style.display = "none";
  });
</script>
