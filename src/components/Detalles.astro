---
import SectionTitle from "./SectionTitle.astro";
import { icon } from "../lib/icons";
// Cada sede reúne sus eventos y su botón de mapa (antes estaba repetido en Ubicaciones).
// "Cómo llegar" abre un menú con enlaces directos a Google Maps, Apple Maps y Waze:
// son <a> normales (no window.open) para que el teléfono abra la app de mapas.
const q = (texto: string) => encodeURIComponent(texto);
const sedes = [
  {
    icono: "church",
    nombre: "Templo de Fátima",
    animacion: "seal",
    mapas: {
      google: "https://www.google.com/maps/search/?api=1&query=" + q("Templo de Fátima, Durango, Dgo."),
      apple: "https://maps.apple.com/?q=" + q("Templo de Fátima, Durango, Dgo."),
      waze: "https://waze.com/ul?q=" + q("Templo de Fátima Durango") + "&navigate=yes",
    },
    eventos: [{ nombre: "Ceremonia religiosa", hora: "5:00 PM" }],
  },
  {
    icono: "cheers",
    nombre: "Salón Casa Meraki",
    animacion: "open",
    // Ubicación exacta del salón (link compartido por los novios).
    mapas: {
      google: "https://maps.app.goo.gl/zRbWCMWQZYUAJLxd6",
      apple: "https://maps.apple.com/?q=" + q("Casa Meraki") + "&ll=24.154039,-104.7045603",
      waze: "https://waze.com/ul?ll=24.154039,-104.7045603&navigate=yes",
    },
    eventos: [
      { nombre: "Ceremonia civil", hora: "8:00 PM" },
      { nombre: "Recepción", hora: "9:00 PM" },
    ],
  },
];
---
<div class="wrap">
  <SectionTitle icon="cal" title="El Gran Día" />

  <div class="date-card">
    <span class="date-side">Sábado</span>
    <div class="date-main">
      <span class="date-month">Abril</span>
      <b class="foil deep">03</b>
      <span class="date-year">2027</span>
    </div>
    <span class="date-side">Durango</span>
  </div>

  {sedes.map((sede) => (
    <div class="venue" data-letter={sede.animacion}>
      <div class="venue-head">
        <div class="venue-ic" set:html={icon(sede.icono)}></div>
        <h3>{sede.nombre}</h3>
      </div>
      <ul>
        {sede.eventos.map((evento) => (
          <li><span>{evento.nombre}</span><b>{evento.hora}</b></li>
        ))}
      </ul>
      <button
        type="button"
        class="btn ghost venue-map"
        data-map-name={sede.nombre}
        data-map-google={sede.mapas.google}
        data-map-apple={sede.mapas.apple}
        data-map-waze={sede.mapas.waze}
      ><span set:html={icon("pin")}></span>Cómo llegar</button>
    </div>
  ))}

  <button class="btn dark mt" id="btnCal"><span set:html={icon("cal")}></span>Agregar al calendario</button>
</div>

<div class="map-sheet" id="mapSheet" aria-hidden="true">
  <div class="map-backdrop" data-map-close></div>
  <div class="map-panel" role="dialog" aria-modal="true" aria-labelledby="mapTitle">
    <div class="map-grip" aria-hidden="true"></div>
    <span class="map-kicker">Cómo llegar a</span>
    <h3 id="mapTitle">Salón</h3>
    <a class="map-opt" id="mapGoogle" target="_blank" rel="noopener">
      <i style="background:#e8f0fe;color:#1a73e8" set:html={icon("pin")}></i>
      <span><b>Google Maps</b><small>Abre la app o el navegador</small></span>
    </a>
    <a class="map-opt" id="mapApple" target="_blank" rel="noopener">
      <i style="background:#eef2f6;color:#3a3a3c" set:html={icon("map")}></i>
      <span><b>Apple Maps</b><small>Mapas del iPhone</small></span>
    </a>
    <a class="map-opt" id="mapWaze" target="_blank" rel="noopener">
      <i style="background:#e4f7fd;color:#05a3d6" set:html={icon("pin")}></i>
      <span><b>Waze</b><small>Navegación paso a paso</small></span>
    </a>
    <button type="button" class="map-cancel" data-map-close>Cancelar</button>
  </div>
</div>

<style>
  .map-sheet {
    position: absolute;
    inset: 0;
    z-index: 160;
    visibility: hidden;
    pointer-events: none;
  }
  .map-sheet.show {
    visibility: visible;
    pointer-events: auto;
  }
  .map-backdrop {
    position: absolute;
    inset: 0;
    background: rgba(33, 29, 23, 0.45);
    backdrop-filter: blur(3px);
    opacity: 0;
    transition: opacity 0.3s ease;
  }
  .map-sheet.show .map-backdrop {
    opacity: 1;
  }
  .map-panel {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    padding: 12px 20px max(18px, env(safe-area-inset-bottom));
    border-top: 1px solid rgba(184, 150, 90, 0.45);
    border-radius: 24px 24px 0 0;
    background: var(--color-paper);
    box-shadow: 0 -18px 40px -20px rgba(33, 29, 23, 0.6);
    text-align: center;
    transform: translateY(105%);
    transition: transform 0.45s cubic-bezier(0.22, 1, 0.36, 1);
  }
  .map-sheet.show .map-panel {
    transform: none;
  }
  .map-grip {
    width: 42px;
    height: 4px;
    margin: 0 auto 14px;
    border-radius: 4px;
    background: var(--color-line);
  }
  .map-kicker {
    color: var(--color-gold-d);
    font-size: 10px;
    letter-spacing: 3px;
    text-transform: uppercase;
  }
  .map-panel h3 {
    margin: 4px 0 14px;
    font-family: var(--font-serif);
    font-size: 24px;
    font-weight: 500;
  }
  .map-opt {
    display: flex;
    align-items: center;
    gap: 14px;
    margin-bottom: 9px;
    padding: 12px 14px;
    border: 1px solid var(--color-line);
    border-radius: 14px;
    background: #fff;
    color: var(--color-ink);
    text-align: left;
    text-decoration: none;
  }
  .map-opt:active {
    background: var(--color-sand);
  }
  .map-opt i {
    display: grid;
    place-items: center;
    width: 40px;
    height: 40px;
    flex-shrink: 0;
    border-radius: 11px;
  }
  .map-opt b {
    display: block;
    font-size: 15px;
    font-weight: 500;
  }
  .map-opt small {
    color: var(--color-soft);
    font-size: 11.5px;
  }
  .map-cancel {
    width: 100%;
    margin-top: 4px;
    padding: 12px;
    border: 0;
    background: transparent;
    color: var(--color-soft);
    font-family: var(--font-sans);
    font-size: 12px;
    letter-spacing: 1.5px;
    text-transform: uppercase;
    cursor: pointer;
  }
  .date-card {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 10px;
    margin-bottom: 16px;
    padding: 22px 18px;
    border: 1px solid rgba(184, 150, 90, 0.5);
    border-radius: 18px;
    background:
      radial-gradient(circle at 50% 0%, rgba(230, 212, 171, 0.45), transparent 65%),
      var(--color-paper);
    box-shadow: 0 0 0 4px rgba(230, 212, 171, 0.25), var(--lift);
  }
  .date-side {
    flex: 1;
    padding: 9px 0;
    border-top: 1px solid var(--color-line);
    border-bottom: 1px solid var(--color-line);
    color: var(--color-gold-d);
    font-size: 11px;
    letter-spacing: 3px;
    text-align: center;
    text-transform: uppercase;
  }
  .date-main {
    display: flex;
    flex-direction: column;
    align-items: center;
    line-height: 1;
  }
  .date-main b {
    font-family: var(--font-serif);
    font-size: 76px;
    font-weight: 500;
    line-height: 0.95;
  }
  .date-month,
  .date-year {
    color: var(--color-ink);
    font-family: var(--font-serif);
    font-size: 17px;
    letter-spacing: 3px;
    text-transform: uppercase;
  }
  .venue {
    position: relative;
    margin-bottom: 14px;
    padding: 18px 18px 16px;
    border: 1px solid var(--color-line);
    border-radius: 16px;
    background: var(--color-paper);
    box-shadow: var(--lift);
  }
  .venue-head {
    display: flex;
    align-items: center;
    gap: 13px;
  }
  .venue-ic {
    display: grid;
    place-items: center;
    width: 34px;
    height: 38px;
    flex-shrink: 0;
    padding-right: 13px;
    border-right: 1px solid var(--color-line);
    color: var(--color-gold-d);
  }
  .venue-ic :global(.svic) {
    width: 30px;
    height: 30px;
    stroke-width: 1.1;
  }
  .venue h3 {
    margin: 0;
    font-family: var(--font-serif);
    font-size: 23px;
    font-weight: 500;
  }
  .venue ul {
    margin: 12px 0 14px;
    padding: 0;
    list-style: none;
  }
  .venue li {
    display: flex;
    align-items: baseline;
    gap: 8px;
    padding: 7px 2px;
    border-bottom: 1px dashed var(--color-line);
    font-size: 13.5px;
  }
  .venue li:last-child {
    border-bottom: 0;
  }
  .venue li span {
    flex: 1;
  }
  .venue li b {
    color: var(--color-gold-d);
    font-family: var(--font-serif);
    font-size: 19px;
    font-weight: 500;
  }
  .venue-map {
    padding: 12px;
    font-size: 12px;
  }
</style>

<script>
  // El menú vive dentro del marco de la invitación (no dentro del área con scroll).
  const sheet = document.getElementById("mapSheet");
  const frame = document.getElementById("frame");
  if (sheet && frame) frame.appendChild(sheet);
  const isIOS = /iphone|ipad|ipod/i.test(navigator.userAgent);

  function closeMap() {
    sheet?.classList.remove("show");
    sheet?.setAttribute("aria-hidden", "true");
  }
  document.querySelectorAll<HTMLElement>("[data-map-google]").forEach((b) =>
    b.addEventListener("click", () => {
      if (!sheet) return;
      const set = (id: string, href = "") => document.getElementById(id)?.setAttribute("href", href);
      set("mapGoogle", b.dataset.mapGoogle);
      set("mapApple", b.dataset.mapApple);
      set("mapWaze", b.dataset.mapWaze);
      const title = document.getElementById("mapTitle");
      if (title) title.textContent = b.dataset.mapName || "";
      // En iPhone, Apple Maps va primero.
      const apple = document.getElementById("mapApple");
      const google = document.getElementById("mapGoogle");
      if (apple && google && isIOS) google.before(apple);
      sheet.classList.add("show");
      sheet.setAttribute("aria-hidden", "false");
    })
  );
  sheet?.querySelectorAll("[data-map-close]").forEach((el) => el.addEventListener("click", closeMap));
  sheet?.querySelectorAll(".map-opt").forEach((el) => el.addEventListener("click", () => window.setTimeout(closeMap, 300)));

  document.getElementById("btnCal")?.addEventListener("click", () => {
    const ics = [
      "BEGIN:VCALENDAR", "VERSION:2.0", "PRODID:-//BodaJC//ES", "BEGIN:VEVENT",
      "UID:" + Date.now() + "@bodajc",
      "DTSTART:20270403T230000Z", "DTEND:20270404T073000Z",
      "SUMMARY:Boda de Jimena & Cristian",
      "LOCATION:Templo de Fatima / Salon Casa Meraki",
      "DESCRIPTION:Religiosa 5PM Fatima. Civil 8PM y recepcion 9PM Casa Meraki.",
      "END:VEVENT", "END:VCALENDAR",
    ].join("\r\n");
    const b = new Blob([ics], { type: "text/calendar" });
    const u = URL.createObjectURL(b);
    const a = document.createElement("a");
    a.href = u; a.download = "Boda-Jimena-Cristian.ics"; a.click();
    URL.revokeObjectURL(u);
  });
</script>
