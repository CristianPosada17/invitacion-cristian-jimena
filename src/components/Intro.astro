---
// Intro · el sobre (video) permanece cerrado hasta que el invitado toca la pantalla.
// Se muestra una sola vez por sesión (solo en la página de Inicio).
---

<div
  id="intro"
  class="absolute inset-0 z-[200] flex items-center justify-center cursor-pointer transition-opacity duration-700 overflow-hidden"
  style="background:#e7dab6"
>
  <video
    id="introVid"
    src="/Sobre.mp4"
    poster="/sobre-poster.png"
    muted
    playsinline
    preload="auto"
    class="w-full h-full object-cover"></video>
  <div id="introGlow" class="pointer-events-none absolute inset-0"></div>
  <div
    id="introGuestCard"
    class="pointer-events-none absolute left-5 right-5 top-[15%] text-center"
  >
    <span>Hemos preparado esta invitación especialmente para</span>
    <strong id="introGuestName">alguien muy especial</strong>
    <small>Nos encantará compartir este día contigo</small>
  </div>
  <div
    id="introHint"
    class="pointer-events-none absolute bottom-12 left-0 right-0 flex flex-col items-center gap-3"
  >
    <span class="tap-ring"></span>
    <span
      class="text-[11px] tracking-[3px] uppercase"
      style="color:rgba(90,66,30,.9)">Toca para abrir</span
    >
  </div>
</div>

<style>
  #intro {
    touch-action: manipulation;
  }
  #introVid {
    pointer-events: none;
  }
  #intro.waiting #introVid {
    animation: breathe 3.6s ease-in-out infinite;
  }
  @keyframes breathe {
    0%,
    100% {
      transform: scale(1);
    }
    50% {
      transform: scale(1.03);
    }
  }
  #introGlow {
    background: radial-gradient(
      circle at 50% 52%,
      rgba(255, 226, 150, 0.55) 0%,
      rgba(255, 210, 120, 0.18) 22%,
      rgba(255, 210, 120, 0) 46%
    );
    mix-blend-mode: screen;
    opacity: 0;
  }
  #intro.waiting #introGlow {
    animation: glow 2.4s ease-in-out infinite;
  }
  #introGuestCard {
    color: rgba(78, 61, 35, 0.94);
    text-shadow: 0 1px 0 rgba(255, 255, 255, 0.44);
    transition:
      opacity 0.3s ease,
      transform 0.45s ease;
  }
  #introGuestCard span,
  #introGuestCard small {
    display: block;
    font-family: var(--font-sans);
    font-size: 9px;
    font-weight: 400;
    letter-spacing: 2px;
    line-height: 1.45;
    text-transform: uppercase;
  }
  #introGuestCard strong {
    display: block;
    max-width: 340px;
    margin: 7px auto 5px;
    font-family: var(--font-serif);
    font-size: 27px;
    font-weight: 500;
    line-height: 1.05;
  }
  #introGuestCard small {
    font-size: 8px;
    letter-spacing: 1.4px;
    opacity: 0.74;
  }
  @keyframes glow {
    0%,
    100% {
      opacity: 0.25;
    }
    50% {
      opacity: 0.85;
    }
  }
  .tap-ring {
    width: 10px;
    height: 10px;
    border-radius: 9999px;
    background: rgba(120, 92, 46, 0.85);
    box-shadow: 0 0 0 0 rgba(120, 92, 46, 0.5);
    animation: ring 2s ease-out infinite;
  }
  @keyframes ring {
    0% {
      box-shadow: 0 0 0 0 rgba(120, 92, 46, 0.45);
    }
    70% {
      box-shadow: 0 0 0 16px rgba(120, 92, 46, 0);
    }
    100% {
      box-shadow: 0 0 0 0 rgba(120, 92, 46, 0);
    }
  }
  #introHint {
    animation: fadePulse 1.8s ease-in-out infinite;
  }
  @keyframes fadePulse {
    0%,
    100% {
      opacity: 0.55;
    }
    50% {
      opacity: 1;
    }
  }
  #intro.playing #introGlow,
  #intro.playing #introHint,
  #intro.playing #introGuestCard {
    opacity: 0 !important;
    animation: none !important;
  }
  #intro.playing #introGuestCard {
    transform: translateY(-8px);
  }
  #intro.gone {
    opacity: 0;
    pointer-events: none;
    visibility: hidden;
  }
  @media (prefers-reduced-motion: reduce) {
    #intro.waiting #introVid,
    #intro.waiting #introGlow,
    .tap-ring,
    #introHint {
      animation: none !important;
    }
  }
</style>

<script>
  import { loadGuest } from "../lib/state";
  import { WEDDING_AUDIO, getGuestNameHint } from "../lib/config";

  const intro = document.getElementById("intro");
  const vid = document.getElementById("introVid") as HTMLVideoElement | null;
  const weddingAudio = document.getElementById(
    "weddingAudio",
  ) as HTMLAudioElement | null;
  let started = false;
  let revealed = false;

  const guestNameHint = getGuestNameHint();
  const introGuestName = document.getElementById("introGuestName");
  if (guestNameHint && introGuestName)
    introGuestName.textContent = guestNameHint;

  loadGuest().then(({ guest }) => {
    const guestName = document.getElementById("introGuestName");
    if (!guestName || !guest?.nombre) return;
    guestName.textContent = [guest.prot, guest.nombre]
      .filter(Boolean)
      .join(" ");
  });

  function startWeddingMusic() {
    if (!weddingAudio || !WEDDING_AUDIO) return;
    if (!weddingAudio.src) weddingAudio.src = WEDDING_AUDIO;
    weddingAudio.volume = 0;
    weddingAudio
      .play()
      .then(() => {
        document.getElementById("audioToggle")?.classList.add("playing");
        let volume = 0;
        const fade = window.setInterval(() => {
          volume = Math.min(0.72, volume + 0.06);
          weddingAudio.volume = volume;
          if (volume >= 0.72) window.clearInterval(fade);
        }, 90);
      })
      .catch(() => {});
  }

  function resetHomeScroll() {
    const app = document.getElementById("app");
    if (!app) return;
    app.style.overflowY = "auto";
    app.scrollTop = 0;
  }

  function reveal() {
    if (revealed || !intro) return;
    revealed = true;
    intro.classList.add("gone");
    resetHomeScroll();
    window.setTimeout(() => {
      intro.remove();
      resetHomeScroll();
    }, 750);
    try {
      sessionStorage.setItem("introSeen", "1");
    } catch (e) {}
    document.body.dispatchEvent(new CustomEvent("intro:done"));
  }

  function start() {
    if (started || !intro) return;
    started = true;
    intro.classList.remove("waiting");
    intro.classList.add("playing");
    startWeddingMusic();
    if (vid) {
      vid.currentTime = 0;
      vid.play().catch(() => reveal());
      setTimeout(reveal, 3200);
    } else {
      reveal();
    }
  }

  let seen = false;
  try {
    seen = sessionStorage.getItem("introSeen") === "1";
  } catch (e) {}

  if (seen) {
    intro?.remove();
    revealed = true;
    window.requestAnimationFrame(resetHomeScroll);
  } else {
    intro?.classList.add("waiting");
    if (vid) {
      vid.pause();
      vid.addEventListener("ended", reveal);
    }
    intro?.addEventListener("click", start);
  }
</script>
