---
// Intro · el sobre (video) permanece cerrado hasta que el invitado toca la pantalla.
// Se muestra una sola vez por sesión (solo en la página de Inicio).
---

<div
  id="intro"
  class="absolute inset-0 z-[200] flex items-center justify-center cursor-pointer transition-opacity duration-700 overflow-hidden"
  style="background:#e7dab6"
>
  <video
    id="introVid"
    src="/Sobre.mp4"
    muted
    playsinline
    preload="auto"
    class="w-full h-full object-cover"></video>
  <div id="introGlow" class="pointer-events-none absolute inset-0"></div>
  <div
    id="introHint"
    class="pointer-events-none absolute bottom-12 left-0 right-0 flex flex-col items-center gap-3"
  >
    <span class="tap-ring"></span>
    <span
      class="text-[11px] tracking-[3px] uppercase"
      style="color:rgba(90,66,30,.9)">Toca para abrir</span
    >
  </div>
</div>

<style>
  #intro.waiting #introVid {
    animation: breathe 3.6s ease-in-out infinite;
  }
  @keyframes breathe {
    0%,
    100% {
      transform: scale(1);
    }
    50% {
      transform: scale(1.03);
    }
  }
  #introGlow {
    background: radial-gradient(
      circle at 50% 52%,
      rgba(255, 226, 150, 0.55) 0%,
      rgba(255, 210, 120, 0.18) 22%,
      rgba(255, 210, 120, 0) 46%
    );
    mix-blend-mode: screen;
    opacity: 0;
  }
  #intro.waiting #introGlow {
    animation: glow 2.4s ease-in-out infinite;
  }
  @keyframes glow {
    0%,
    100% {
      opacity: 0.25;
    }
    50% {
      opacity: 0.85;
    }
  }
  .tap-ring {
    width: 10px;
    height: 10px;
    border-radius: 9999px;
    background: rgba(120, 92, 46, 0.85);
    box-shadow: 0 0 0 0 rgba(120, 92, 46, 0.5);
    animation: ring 2s ease-out infinite;
  }
  @keyframes ring {
    0% {
      box-shadow: 0 0 0 0 rgba(120, 92, 46, 0.45);
    }
    70% {
      box-shadow: 0 0 0 16px rgba(120, 92, 46, 0);
    }
    100% {
      box-shadow: 0 0 0 0 rgba(120, 92, 46, 0);
    }
  }
  #introHint {
    animation: fadePulse 1.8s ease-in-out infinite;
  }
  @keyframes fadePulse {
    0%,
    100% {
      opacity: 0.55;
    }
    50% {
      opacity: 1;
    }
  }
  #intro.playing #introGlow,
  #intro.playing #introHint {
    opacity: 0 !important;
    animation: none !important;
  }
  #intro.gone {
    opacity: 0;
    pointer-events: none;
  }
  @media (prefers-reduced-motion: reduce) {
    #intro.waiting #introVid,
    #intro.waiting #introGlow,
    .tap-ring,
    #introHint {
      animation: none !important;
    }
  }
</style>

<script>
  const intro = document.getElementById("intro");
  const vid = document.getElementById("introVid") as HTMLVideoElement | null;
  let started = false;
  let revealed = false;

  function reveal() {
    if (revealed || !intro) return;
    revealed = true;
    intro.classList.add("gone");
    try {
      sessionStorage.setItem("introSeen", "1");
    } catch (e) {}
    document.body.dispatchEvent(new CustomEvent("intro:done"));
  }

  function start() {
    if (started || !intro) return;
    started = true;
    intro.classList.remove("waiting");
    intro.classList.add("playing");
    if (vid) {
      vid.currentTime = 0;
      vid.play().catch(() => reveal());
      setTimeout(reveal, 3200);
    } else {
      reveal();
    }
  }

  let seen = false;
  try {
    seen = sessionStorage.getItem("introSeen") === "1";
  } catch (e) {}

  if (seen) {
    intro?.classList.add("gone");
    revealed = true;
  } else {
    intro?.classList.add("waiting");
    if (vid) {
      vid.pause();
      const showFirstFrame = () => {
        try {
          vid.currentTime = 0.02;
        } catch (e) {}
      };
      if (vid.readyState >= 2) showFirstFrame();
      else vid.addEventListener("loadeddata", showFirstFrame, { once: true });
      vid.addEventListener("ended", reveal);
    }
    intro?.addEventListener("click", start);
  }
</script>
