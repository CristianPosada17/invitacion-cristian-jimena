---
import SectionTitle from "./SectionTitle.astro";
import { icon } from "../lib/icons";
const momentos = [
  { hora: "5:00 PM", nombre: "Ceremonia religiosa", lugar: "Templo de Fátima", icono: "church" },
  { hora: "8:00 PM", nombre: "Ceremonia civil", lugar: "Salón Casa Meraki", icono: "rings" },
  { hora: "8:30 PM", nombre: "Cóctel de bienvenida", lugar: "Salón Casa Meraki", icono: "cheers" },
  { hora: "9:00 PM", nombre: "Inicio de la recepción", lugar: "Salón Casa Meraki", icono: "heart" },
];
---
<div class="wrap">
  <SectionTitle icon="clock" title="Itinerario" />
  <div class="card">
    <div class="tl tl-icons">
      {momentos.map((m) => (
        <div class="it">
          <i class="tl-ic" aria-hidden="true" set:html={icon(m.icono)}></i>
          <b>{m.hora}</b><span>{m.nombre}</span>{m.lugar && <small>{m.lugar}</small>}
        </div>
      ))}
    </div>
  </div>
</div>
