---
import SectionTitle from "./SectionTitle.astro";
const fotos = [
  { src: "/galeria/jc-13.jpg", alt: "Jimena y Cristian sonriendo juntos" },
  { src: "/galeria/jc-17.jpg", alt: "Las manos de Jimena y Cristian con el anillo de compromiso" },
  { src: "/galeria/jc-15.jpg", alt: "Jimena y Cristian bajo un arco de cantera" },
  { src: "/galeria/jc-22.jpg", alt: "Jimena y Cristian entre luces" },
];
---
<div style="padding:34px 0 0">
  <SectionTitle title="Nuestra Historia" />

  <!-- Save the date: video cinematográfico. Al reproducirlo se pausa la música de fondo. -->
  <div class="std">
    <div class="std-frame">
      <video
        id="stdVideo"
        src="/save-the-date.mp4"
        poster="/save-the-date.jpg"
        preload="none"
        playsinline
        aria-label="Video save the date de Jimena y Cristian"
      ></video>
      <button type="button" class="std-play" id="stdPlay" aria-label="Reproducir video save the date">
        <span class="std-play-ring"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M8 5.5v13l11-6.5z"></path></svg></span>
        <span class="std-play-label">Ver nuestro save the date</span>
      </button>
    </div>
  </div>

  <div class="carousel mt" aria-label="Momentos de Jimena y Cristian">
    {fotos.map((foto) => (
      <img class="story-photo" src={foto.src} alt={foto.alt} loading="lazy" decoding="async" />
    ))}
  </div>
  <p class="story-hint">Desliza para ver más momentos</p>
</div>

<style>
  .std {
    margin: 4px 22px 0;
  }
  .std-frame {
    position: relative;
    overflow: hidden;
    border: 1px solid rgba(214, 180, 108, 0.55);
    border-radius: 18px;
    background: var(--color-dark);
    aspect-ratio: 1280 / 608;
    box-shadow: 0 0 0 4px rgba(230, 212, 171, 0.3), 0 24px 44px -28px rgba(33, 29, 23, 0.9);
  }
  .std-frame video {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    background: var(--color-dark);
  }
  .std-play {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 9px;
    border: 0;
    background: radial-gradient(circle at 50% 50%, rgba(20, 16, 12, 0.1), rgba(20, 16, 12, 0.5));
    color: #fff;
    cursor: pointer;
    transition: opacity 0.35s ease;
  }
  .std-play.hidden {
    opacity: 0;
    pointer-events: none;
  }
  .std-play-ring {
    display: grid;
    place-items: center;
    width: 52px;
    height: 52px;
    border: 1px solid rgba(242, 222, 176, 0.85);
    border-radius: 50%;
    background: rgba(20, 16, 12, 0.35);
    backdrop-filter: blur(4px);
    box-shadow: 0 0 0 0 rgba(242, 222, 176, 0.5);
    animation: stdPulse 2.2s ease-out infinite;
  }
  .std-play-ring svg {
    width: 20px;
    height: 20px;
    margin-left: 3px;
    fill: #f2deb0;
  }
  .std-play-label {
    font-family: var(--font-serif);
    font-size: 16px;
    font-style: italic;
    letter-spacing: 0.5px;
    text-shadow: 0 2px 10px rgba(0, 0, 0, 0.6);
  }
  @keyframes stdPulse {
    0% { box-shadow: 0 0 0 0 rgba(242, 222, 176, 0.5); }
    80%, 100% { box-shadow: 0 0 0 14px rgba(242, 222, 176, 0); }
  }
  .story-photo {
    flex: 0 0 68%;
    width: 68%;
    height: 238px;
    border-radius: 16px;
    border: 1px solid var(--color-line);
    object-fit: cover;
    object-position: center;
    scroll-snap-align: center;
  }
  .story-hint {
    margin: 11px 0 0;
    color: var(--color-soft);
    font-size: 11px;
    letter-spacing: 1px;
    text-align: center;
    text-transform: uppercase;
  }
  @media (prefers-reduced-motion: reduce) {
    .std-play-ring { animation: none; }
  }
</style>

<script>
  const video = document.getElementById("stdVideo") as HTMLVideoElement | null;
  const play = document.getElementById("stdPlay");
  const music = document.getElementById("weddingAudio") as HTMLAudioElement | null;
  let musicWasPlaying = false;

  play?.addEventListener("click", () => {
    video?.play().catch(() => {});
  });

  video?.addEventListener("play", () => {
    play?.classList.add("hidden");
    if (video) video.controls = true;
    // Pausamos la canción de fondo para que se escuche el video.
    if (music && !music.paused) {
      musicWasPlaying = true;
      music.pause();
    }
  });
  function resumeMusic() {
    if (musicWasPlaying && music) music.play().catch(() => {});
    musicWasPlaying = false;
  }
  video?.addEventListener("pause", resumeMusic);
  video?.addEventListener("ended", () => {
    play?.classList.remove("hidden");
    resumeMusic();
  });
</script>
