---
// Hero · portada a pantalla completa
const fecha = "3 DE ABRIL DE 2027";
---

<section
  id="hero"
  class="relative h-[100dvh] max-h-[900px] min-h-[600px] text-white text-center flex flex-col items-center justify-center overflow-hidden"
>
  <img
    src="/galeria/foto-8.jpg"
    alt=""
    aria-hidden="true"
    fetchpriority="high"
    decoding="async"
    class="absolute inset-0 w-full h-full object-cover"
    style="object-position:46% center;filter:brightness(.84) saturate(.9)"
  />
  <div
    class="absolute inset-0"
    style="background:linear-gradient(180deg,rgba(20,16,12,.54) 0%,rgba(20,16,12,.27) 40%,rgba(20,16,12,.42) 68%,rgba(20,16,12,.82) 100%)"
  >
  </div>
  <div
    class="absolute inset-0"
    style="background:radial-gradient(ellipse at 50% 44%,transparent 10%,rgba(16,12,9,.28) 82%)"
  >
  </div>

  <div class="relative z-10 px-6 flex flex-col items-center">
    <img
      src="/logo-boda.png"
      alt="Cristian & Jimena"
      class="w-[200px] h-[200px] object-contain mb-6"
      style="filter:drop-shadow(0 3px 12px rgba(0,0,0,.5)) brightness(1.15) saturate(1.1)"
    />
    <p class="text-[12px] tracking-[7px] uppercase opacity-90 mb-7">
      Nos casamos
    </p>

    <h1
      class="font-script text-[80px] leading-none"
      style="text-shadow:0 3px 26px rgba(0,0,0,.4)"
    >
      Cristian
    </h1>
    <span class="font-script text-[44px] text-champ my-3">&amp;</span>
    <h1
      class="font-script text-[80px] leading-none"
      style="text-shadow:0 3px 26px rgba(0,0,0,.4)"
    >
      Jimena
    </h1>

    <div class="w-16 h-px bg-white/60 my-8"></div>
    <p class="tracking-[4px] text-[15px]">{fecha}</p>
    <p class="font-light text-[13px] opacity-90 mt-5 leading-relaxed">
      Acompáñanos en el inicio<br />de nuestra historia.
    </p>
  </div>

  <div
    class="absolute bottom-7 left-0 right-0 z-10 flex justify-center opacity-85 animate-bounce"
  >
    <svg
      width="26"
      height="26"
      viewBox="0 0 24 24"
      fill="none"
      stroke="#fff"
      stroke-width="1.4"
      stroke-linecap="round"
      stroke-linejoin="round"
    >
      <path d="M6 9l6 6 6-6"></path>
    </svg>
  </div>
</section>
