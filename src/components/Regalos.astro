---
import SectionTitle from "./SectionTitle.astro";
import { icon } from "../lib/icons";
import { MESAS_REGALOS } from "../lib/config";
---

<div class="wrap">
  <SectionTitle title="Regalos" />
  <div class="card">
    <div class="dcard" style="padding-bottom:12px">
      <div class="ic" set:html={icon("gift")} />
      <div class="tx">
        <b>Mesas de Regalos</b><span>Elige la tienda que prefieras</span>
      </div>
    </div>
    {MESAS_REGALOS.map((mesa) => (
      <a
        class={mesa.url ? "registry" : "registry soon"}
        data-registry={mesa.id}
        href={mesa.url || undefined}
        target="_blank"
        rel="noopener"
      >
        <span class="registry-name">{mesa.tienda}</span>
        <span class="registry-state">{mesa.url ? "Ver lista" : "Próximamente"}</span>
      </a>
    ))}
  </div>
  <div class="card">
    <div class="dcard" style="padding-bottom:10px">
      <div class="ic" set:html={icon("cash")} />
      <div class="tx">
        <b>Regalo en efectivo</b><span>Si lo prefieres, con mucho cariño</span>
      </div>
    </div>
    <div class="copyrow">
      <div>
        <div class="l">Banco</div><div class="v" id="bkBanco">BBVA</div>
      </div><button data-copy="bkBanco">Copiar</button>
    </div>
    <div class="copyrow">
      <div>
        <div class="l">Titular</div><div class="v" id="bkTitular">
          Cristian Adan Parra Posada
        </div>
      </div><button data-copy="bkTitular">Copiar</button>
    </div>
    <div class="copyrow">
      <div>
        <div class="l">CLABE</div><div class="v" id="bkClabe">
          012 180 015482500115
        </div>
      </div><button data-copy="bkClabe">Copiar</button>
    </div>
  </div>
  <div style="height:20px"></div>
</div>

<script>
  import { boot, toast } from "../lib/state";
  boot().then((s) => {
    const cfg = s.config || {};
    const set = (id: string, v: any) => {
      const el = document.getElementById(id);
      if (el && v) el.textContent = v;
    };
    set("bkBanco", cfg.banco);
    set("bkTitular", cfg.titular);
    set("bkClabe", cfg.clabe);
    // Si el Apps Script trae el link (sears_url / liverpool_url), se activa la tienda.
    document.querySelectorAll<HTMLAnchorElement>("[data-registry]").forEach((link) => {
      const url = cfg[link.dataset.registry + "_url"];
      if (!url || link.getAttribute("href")) return;
      link.href = url;
      link.classList.remove("soon");
      const state = link.querySelector(".registry-state");
      if (state) state.textContent = "Ver lista";
    });
  });
  document.querySelectorAll<HTMLAnchorElement>("[data-registry]").forEach((link) =>
    link.addEventListener("click", (event) => {
      if (link.getAttribute("href")) return;
      event.preventDefault();
      toast("Lista disponible próximamente");
    }),
  );
  document.querySelectorAll("[data-copy]").forEach((b) =>
    b.addEventListener("click", () => {
      const id = (b as HTMLElement).dataset.copy!;
      const v = document.getElementById(id)?.textContent || "";
      if (navigator.clipboard) navigator.clipboard.writeText(v);
      toast("Copiado");
    }),
  );
</script>

<style>
  .registry {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 10px;
    margin-top: 8px;
    padding: 14px 16px;
    border: 1px solid var(--color-gold);
    border-radius: 12px;
    background: #fff;
    color: var(--color-ink);
    text-decoration: none;
    cursor: pointer;
    transition: background 0.2s ease;
  }
  .registry:active {
    background: var(--color-sand);
  }
  .registry-name {
    font-family: var(--font-serif);
    font-size: 21px;
    font-weight: 500;
    letter-spacing: 0.5px;
  }
  .registry-state {
    padding: 6px 12px;
    border-radius: 20px;
    background: var(--color-gold);
    color: #fff;
    font-size: 10.5px;
    letter-spacing: 1.4px;
    text-transform: uppercase;
  }
  .registry.soon {
    border-style: dashed;
    border-color: var(--color-line);
  }
  .registry.soon .registry-state {
    background: var(--color-sand);
    color: var(--color-gold-d);
  }
</style>
