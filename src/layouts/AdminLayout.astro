---
import "../styles/global.css";
interface Props { title?: string; }
const { title = "Admin · Boda Cristian & Jimena" } = Astro.props;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#2a251c" />
    <meta name="robots" content="noindex" />
    <title>{title}</title>
    <link rel="icon" type="image/png" href="/logo-cj.png" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@400;500;600&family=Jost:wght@300;400;500&display=swap"
      rel="stylesheet"
    />
  </head>
  <body class="adminbody">
    <slot />
  </body>
</html>

<style is:global>
  /* El admin NO usa el marco de celular: es página web normal y responsiva */
  body.adminbody {
    display: block;
    background: #f4eee1;
    min-height: 100vh;
    color: var(--color-ink);
  }
  .admin-wrap { max-width: 1100px; margin: 0 auto; padding: 22px 16px 70px; }
  .a-head { text-align: center; margin: 10px 0 22px; }
  .a-head .eyebrow { }
  .a-head h1 { font-family: var(--font-serif); font-weight: 500; font-size: 34px; margin-top: 4px; }
  .a-stats { display: grid; grid-template-columns: repeat(4, 1fr); gap: 12px; margin-bottom: 22px; }
  @media (max-width: 640px) { .a-stats { grid-template-columns: repeat(2, 1fr); } }
  .a-stat { background: #fff; border: 1px solid var(--color-line); border-radius: 14px; padding: 16px; text-align: center; }
  .a-stat b { font-family: var(--font-serif); font-size: 30px; color: var(--color-gold-d); display: block; line-height: 1; }
  .a-stat span { font-size: 11px; letter-spacing: 1px; text-transform: uppercase; color: var(--color-soft); }
  .a-panel { background: #fff; border: 1px solid var(--color-line); border-radius: 16px; padding: 18px; margin-bottom: 20px; }
  .a-panel h2 { font-family: var(--font-serif); font-weight: 500; font-size: 22px; margin-bottom: 12px; }
  .a-input { width: 100%; border: 1px solid var(--color-line); border-radius: 10px; padding: 12px 14px; font-family: var(--font-sans); font-size: 15px; outline: none; }
  .a-input:focus { border-color: var(--color-gold); }
  .a-btn { background: var(--color-gold); color: #fff; border: 0; border-radius: 10px; padding: 12px 18px; cursor: pointer; font-family: var(--font-sans); letter-spacing: 1px; }
  .a-btn.a-secondary { background: #faf6ec; color: var(--color-gold-d); border: 1px solid var(--color-line); white-space: nowrap; }
  .link-info { display: flex; align-items: center; justify-content: space-between; gap: 18px; background: #faf6ec; border: 1px solid var(--color-line); border-radius: 12px; padding: 14px 16px; margin-bottom: 14px; }
  .link-info b { display: block; font-size: 13px; color: var(--color-ink); }
  .link-info p { max-width: 690px; margin: 4px 0 0; color: var(--color-soft); font-size: 12px; line-height: 1.5; }
  .link-origin { flex: 0 0 auto; text-align: right; }
  .link-origin span { display: block; color: var(--color-soft); font-size: 10px; letter-spacing: 1px; text-transform: uppercase; }
  .link-origin code { display: block; margin-top: 4px; color: var(--color-gold-d); font-size: 12px; }
  .a-toolbar { display: grid; grid-template-columns: minmax(220px, 1fr) auto auto; gap: 10px; align-items: center; }
  .link-feedback { min-height: 19px; margin: 7px 2px 4px; color: var(--color-sage-d); font-size: 12px; }
  .link-feedback.error { color: #a5604f; }
  table.a-table { width: 100%; border-collapse: collapse; font-size: 14px; }
  .a-table th, .a-table td { text-align: left; padding: 10px 8px; border-bottom: 1px solid var(--color-line); white-space: nowrap; }
  .a-table th { font-size: 11px; letter-spacing: 1px; text-transform: uppercase; color: var(--color-soft); }
  .a-scroll { overflow-x: auto; }
  .tag { font-size: 11px; padding: 3px 9px; border-radius: 20px; }
  .tag.yes { background: #e7efe1; color: #5f7150; }
  .tag.no { background: #f2e2df; color: #a5604f; }
  .tag.pend { background: #f1ead7; color: #98803f; }
  .a-link { border: 1px solid var(--color-line); background: #faf6ec; border-radius: 8px; padding: 6px 10px; cursor: pointer; font-size: 12px; font-family: var(--font-sans); }
  .link-cell { min-width: 310px; white-space: normal; }
  .link-url { display: block; max-width: 390px; color: var(--color-soft); font-size: 11px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .link-actions { display: flex; gap: 7px; margin-top: 7px; }
  .a-open { display: inline-flex; align-items: center; color: var(--color-gold-d); text-decoration: none; }
  .a-photos { display: grid; grid-template-columns: repeat(auto-fill, minmax(120px, 1fr)); gap: 10px; }
  .a-photo { position: relative; border-radius: 10px; overflow: hidden; border: 1px solid var(--color-line); }
  .a-photo img { width: 100%; height: 120px; object-fit: cover; display: block; }
  .a-photo button { position: absolute; top: 6px; right: 6px; background: rgba(0,0,0,.55); color: #fff; border: 0; border-radius: 8px; padding: 4px 8px; cursor: pointer; font-size: 11px; }
  .gate { max-width: 360px; margin: 60px auto; background: #fff; border: 1px solid var(--color-line); border-radius: 16px; padding: 26px; text-align: center; }
  @media (max-width: 720px) {
    .link-info { align-items: flex-start; flex-direction: column; }
    .link-origin { text-align: left; }
    .a-toolbar { grid-template-columns: 1fr 1fr; }
    .a-toolbar .a-input { grid-column: 1 / -1; }
  }
</style>
