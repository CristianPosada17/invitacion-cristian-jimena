---
import "../styles/global.css";
import Nav from "../components/Nav.astro";
import InstallPrompt from "../components/InstallPrompt.astro";
import { WEDDING_AUDIO } from "../lib/config";

interface Props {
  title?: string;
  description?: string;
  active?: string;
}

const {
  title = "Jimena & Cristian · 3 de Abril 2027",
  description = "Nos casamos. Acompáñanos en el inicio de nuestra historia.",
  active = "inicio",
} = Astro.props;
const siteUrl = "https://cristian-y-jimena.netlify.app";
const shareImage = siteUrl + "/og-boda.png?v=3";
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta
      name="viewport"
      content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no"
    />
    <meta name="theme-color" content="#e6d4ab" />
    <meta name="description" content={description} />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-title" content="Boda J&C" />
    <meta name="apple-mobile-web-app-status-bar-style" content="default" />
    <link rel="icon" type="image/png" href="/logo-boda.png" />
    <link rel="apple-touch-icon" href="/icons/icon-192.png" />
    <link rel="manifest" href="/manifest.webmanifest" />

    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={siteUrl} />
    <meta property="og:image" content={shareImage} />
    <meta property="og:image:secure_url" content={shareImage} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Logo de la boda de Jimena y Cristian" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={shareImage} />

    <title>{title}</title>

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,400;0,500;0,600;1,400;1,500&family=Jost:wght@300;400;500&family=Pinyon+Script&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <svg width="0" height="0" style="position:absolute" aria-hidden="true" focusable="false">
      <defs>
        <linearGradient id="goldStroke" gradientUnits="userSpaceOnUse" x1="2" y1="2" x2="22" y2="22">
          <stop offset="0" stop-color="#8a6629"></stop>
          <stop offset=".45" stop-color="#d2ae63"></stop>
          <stop offset=".62" stop-color="#b08a45"></stop>
          <stop offset="1" stop-color="#7a5822"></stop>
        </linearGradient>
      </defs>
    </svg>
    <div id="frame">
      <slot name="overlay" />
      <div id="app">
        <slot />
      </div>
      <audio id="weddingAudio" src={WEDDING_AUDIO || undefined} loop preload="none"></audio>
      {WEDDING_AUDIO && (
        <button id="audioToggle" type="button" aria-label="Pausar música" aria-pressed="true">
          <svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
            <path d="M9 18V5l10-2v13"></path>
            <circle cx="6.5" cy="18" r="2.5"></circle>
            <circle cx="16.5" cy="16" r="2.5"></circle>
          </svg>
        </button>
      )}
      <Nav active={active} />
      <InstallPrompt />
      <div class="toast" id="toast"></div>
    </div>

    <script>
      const revealTargets = Array.from(
        document.querySelectorAll<HTMLElement>(
          // El hero tiene su propia coreografía y los <dialog> no deben heredar opacidad 0.
          "#app > .welcome, #app > .landing-section > :not(style):not(script):not(dialog)"
        )
      );
      let revealsStarted = false;

      const revealObserver = "IntersectionObserver" in window
        ? new IntersectionObserver(
            (entries) => {
              entries.forEach((entry) => {
                if (!entry.isIntersecting) return;
                entry.target.classList.add("is-visible");
                revealObserver?.unobserve(entry.target);
              });
            },
            { threshold: 0.08, rootMargin: "0px 0px -5% 0px" }
          )
        : null;

      revealTargets.forEach((target, index) => {
        target.classList.add("reveal", "reveal-soft");
        target.style.setProperty("--reveal-delay", String((index % 3) * 55) + "ms");
      });

      // Además de cada bloque, sus tarjetas/fotos/renglones entran uno tras otro.
      const itemTargets = Array.from(
        document.querySelectorAll<HTMLElement>(
          "#app .landing-section :is(.ecard, .venue, .card, .tl .it, .gallery-item, .gallery-feature, .registry, .copyrow, .story-photo, .std, .notice, .date-card, .music-card, .weather-card, .cd-night, .thanks), #app > .foto-banda"
        )
      ).filter((el) => !el.classList.contains("reveal"));
      const itemObserver = "IntersectionObserver" in window
        ? new IntersectionObserver(
            (entries) => {
              let order = 0;
              entries.forEach((entry) => {
                if (!entry.isIntersecting) return;
                const el = entry.target as HTMLElement;
                el.style.setProperty("--item-delay", String(order++ * 90) + "ms");
                el.classList.add("is-visible");
                itemObserver?.unobserve(el);
              });
            },
            { threshold: 0.12, rootMargin: "0px 0px -6% 0px" }
          )
        : null;
      // Tarjetas tipo sobre. Cada una elige su animación con data-letter:
      //  seal: la solapa se cierra y se estampa el sello (por defecto)
      //  open: el sello se rompe, la solapa se abre y la tarjeta sale del sobre
      //  drop: el sobre cae suavemente, ladeado, y luego se sella
      // La confirmación (#rsvp-box) se dibuja con JS y anima su propia tarjeta.
      itemTargets.forEach((el) => {
        el.classList.add("reveal-item");
        if (!el.matches(".card, .venue") || el.closest("#rsvp-box")) return;
        const variant = el.dataset.letter || "seal";
        el.classList.add("letter", "v-" + variant);
        if (variant === "open") el.insertAdjacentHTML("beforeend", '<span class="env-pocket" aria-hidden="true"></span>');
      });

      function startReveals() {
        if (revealsStarted) return;
        revealsStarted = true;
        document.getElementById("hero")?.classList.add("hero-ready");
        revealTargets.forEach((target) => {
          if (revealObserver) revealObserver.observe(target);
          else target.classList.add("is-visible");
        });
        itemTargets.forEach((el) => {
          if (itemObserver) itemObserver.observe(el);
          else el.classList.add("is-visible");
        });
      }

      if (document.getElementById("intro")) {
        document.body.addEventListener("intro:done", startReveals, { once: true });
      } else {
        startReveals();
      }

      const weddingAudio = document.getElementById("weddingAudio") as HTMLAudioElement | null;
      const audioToggle = document.getElementById("audioToggle") as HTMLButtonElement | null;
      function syncAudioButton() {
        if (!weddingAudio || !audioToggle) return;
        const playing = !weddingAudio.paused;
        audioToggle.classList.toggle("playing", playing);
        audioToggle.setAttribute("aria-pressed", String(playing));
        audioToggle.setAttribute("aria-label", playing ? "Pausar música" : "Reproducir música");
      }
      audioToggle?.addEventListener("click", () => {
        if (!weddingAudio) return;
        if (weddingAudio.paused) weddingAudio.play().catch(() => {});
        else weddingAudio.pause();
      });
      weddingAudio?.addEventListener("play", syncAudioButton);
      weddingAudio?.addEventListener("pause", syncAudioButton);
    </script>
  </body>
</html>
